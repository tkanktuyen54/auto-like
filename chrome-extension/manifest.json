{
  "manifest_version": 3,
  "name": "AutoClap — Telegram Web",
  "version": "1.0.0",
  "description": "Tự thả 👏 khi tin mới trong nhóm Telegram Web đang mở có số điện thoại và từ care.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AutoClap",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/k/*"],
      "js": ["core.js", "webk.js", "main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/k/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
